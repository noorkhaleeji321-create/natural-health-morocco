{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/proxy-image(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(webp|jpg|jpeg|png|gif|svg|ico|css|js|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "functions": {
    "api/sitemap.ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/bootstrap.ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/track-order.ts": {
      "includeFiles": "firebase-applet-config.json"
    },
    "api/seo.ts": {
      "includeFiles": "{firebase-applet-config.json,dist/index.html}"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/((?!sitemap|bootstrap|track-order|seo).*)",
      "destination": "/api"
    },
    {
      "source": "/product/:id",
      "destination": "/api/seo?type=product&id=:id"
    },
    {
      "source": "/category/:slug",
      "destination": "/api/seo?type=category&slug=:slug"
    },
    {
      "source": "/products",
      "destination": "/api/seo?type=page&page=products"
    },
    {
      "source": "/order-tracking",
      "destination": "/api/seo?type=page&page=order-tracking"
    },
    {
      "source": "/policy",
      "destination": "/api/seo?type=page&page=policy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
